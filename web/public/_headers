# Cloudflare Pages (Netlify reads it too): the service worker and app settings are always checked for a new version
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
# built files carry their content hash in the name: cache them for a year at the CDN and in the browser
/assets/*
  Cache-Control: public, max-age=31536000, immutable
